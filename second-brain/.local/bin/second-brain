#!/usr/bin/env bash
set -euo pipefail

# second-brain — CLI for managing Second Brain environment variables
# Reads/writes SB_TASK_PROJECT and SB_TASK_TAGS in mise.local.toml

SB_DIR="${SB_DIR:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/second-brain}"
MISE_CONFIG="${MISE_DEFAULT_CONFIG_FILENAME:-mise.local.toml}"

# --- Helpers ---

_read_key() {
  mise set "$1" 2>/dev/null || true
}

_write_key() {
  mise set --file "$MISE_CONFIG" "$1=$2"
}

_remove_key() {
  mise unset --file "$MISE_CONFIG" "$1" 2>/dev/null || true
}

_current_tags() {
  _read_key SB_TASK_TAGS
}

_current_project() {
  _read_key SB_TASK_PROJECT
}

_tag_add() {
  local new_tag="$1"
  local current
  current="$(_current_tags)"

  if [[ -n "$current" ]]; then
    # Check for duplicate
    local IFS=,
    for tag in $current; do
      tag="${tag## }"; tag="${tag%% }"
      if [[ "$tag" == "$new_tag" ]]; then
        echo "Tag '$new_tag' already exists" >&2
        return 0
      fi
    done
    _write_key SB_TASK_TAGS "$current,$new_tag"
  else
    _write_key SB_TASK_TAGS "$new_tag"
  fi
}

_tag_rm() {
  local target="$1"
  local current
  current="$(_current_tags)"

  if [[ -z "$current" ]]; then
    echo "No tags set" >&2
    return 1
  fi

  local result=""
  local found=false
  local IFS=,
  for tag in $current; do
    tag="${tag## }"; tag="${tag%% }"
    if [[ "$tag" == "$target" ]]; then
      found=true
    elif [[ -n "$tag" ]]; then
      result="${result:+$result,}$tag"
    fi
  done

  if [[ "$found" == false ]]; then
    echo "Tag '$target' not found" >&2
    return 1
  fi

  if [[ -z "$result" ]]; then
    _remove_key SB_TASK_TAGS
  else
    _write_key SB_TASK_TAGS "$result"
  fi
}

_project_list() {
  local show_all=false
  local flat=false
  for arg in "$@"; do
    case "$arg" in
      --all)  show_all=true ;;
      --flat) flat=true ;;
    esac
  done

  local current
  current="$(_current_project)"
  local projects_dir="$SB_DIR/projects"
  local archive_dir="$SB_DIR/archive"

  if [[ -d "$projects_dir" ]]; then
    for d in "$projects_dir"/*/; do
      [[ -d "$d" ]] || continue
      local name
      name="$(basename "$d")"
      if [[ "$flat" == true ]]; then
        local has_children=false
        for child in "$d"/*/; do
          [[ -d "$child" ]] || continue
          has_children=true
          echo "$name/$(basename "$child")"
        done
        [[ "$has_children" == false ]] && echo "$name"
      else
        local marker="  "
        [[ "$name" == "$current" ]] && marker="* "
        echo "$marker$name"
        for child in "$d"/*/; do
          [[ -d "$child" ]] || continue
          echo "    └── $(basename "$child")"
        done
      fi
    done
  fi

  if [[ "$show_all" == true && -d "$archive_dir" ]]; then
    for d in "$archive_dir"/*/; do
      [[ -d "$d" ]] || continue
      local name
      name="$(basename "$d")"
      if [[ "$flat" == true ]]; then
        local has_children=false
        for child in "$d"/*/; do
          [[ -d "$child" ]] || continue
          has_children=true
          echo "$name/$(basename "$child")"
        done
        [[ "$has_children" == false ]] && echo "$name"
      else
        echo "  $name [archived]"
        for child in "$d"/*/; do
          [[ -d "$child" ]] || continue
          echo "    └── $(basename "$child")"
        done
      fi
    done
  fi
}

_slugify() {
  local s="${1,,}"       # lowercase
  s="${s// /-}"          # spaces to dashes
  s="${s////-}"          # slashes to dashes
  s="${s//:/}"           # strip colons
  s="${s//\?/}"          # strip question marks
  s="${s//!/}"           # strip exclamation marks
  echo "$s"
}

_inbox() {
  local title="${*:-Inbox}"
  local slug
  slug="$(_slugify "$title")"
  local fname
  fname="$(date +%F)-$slug.md"

  cd "$SB_DIR" || exit 1
  nb add --folder "inbox" -f "$fname" -t "$title" \
    --template "resources/templates/inbox.md" --edit
}

_inbox_encrypt() {
  cd "$SB_DIR" || exit 1
  nb add --title "${*:-Secret}" --encrypt
}

_project_archive() {
  local name="$1"
  local src="$SB_DIR/projects/$name"
  local dest="$SB_DIR/archive/$name"

  if [[ ! -d "$src" ]]; then
    echo "Project '$name' not found in $SB_DIR/projects/" >&2
    return 1
  fi
  if [[ -d "$dest" ]]; then
    echo "Archive already contains '$name'" >&2
    return 1
  fi

  mkdir -p "$SB_DIR/archive"
  mv "$src" "$dest"
  echo "Archived '$name'"
}

_project_unarchive() {
  local name="$1"
  local src="$SB_DIR/archive/$name"
  local dest="$SB_DIR/projects/$name"

  if [[ ! -d "$src" ]]; then
    echo "Project '$name' not found in $SB_DIR/archive/" >&2
    return 1
  fi
  if [[ -d "$dest" ]]; then
    echo "Active projects already contains '$name'" >&2
    return 1
  fi

  mkdir -p "$SB_DIR/projects"
  mv "$src" "$dest"
  echo "Unarchived '$name'"
}

# --- Triage helpers ---

_TRIAGE_MOVED=()
_TRIAGE_DELETED=()
_TRIAGE_SKIPPED=()
_TRIAGE_EDITED=()

_triage_preview() {
  local filepath="$1"
  local mime
  mime="$(file --mime-type -b "$filepath")"

  case "$mime" in
    text/*|application/json|application/xml)
      echo ""
      if command -v bat &>/dev/null; then
        bat --style=plain --paging=never --color=always "$filepath"
      else
        cat "$filepath"
      fi
      echo ""
      ;;
    image/*)
      echo "  [image: $(basename "$filepath")]"
      qlmanage -p "$filepath" &>/dev/null &
      ;;
    *)
      echo "  [binary: $mime — $(basename "$filepath")]"
      ;;
  esac
}

_triage_pick_dest() {
  local category="$1"
  local dir="$SB_DIR/$category"
  local -a folders=()

  for d in "$dir"/*/; do
    [[ -d "$d" ]] || continue
    local name
    name="$(basename "$d")"
    [[ "$name" == "templates" ]] && continue
    folders+=("$name")
  done

  folders+=("+ Create new folder")

  local choice
  if ! choice=$(printf '%s\n' "${folders[@]}" | gum filter --header "Pick $category folder:"); then
    return 1
  fi
  [[ -z "$choice" ]] && return 1

  if [[ "$choice" == "+ Create new folder" ]]; then
    local new_name
    if ! new_name=$(gum input --header "New folder name:" --placeholder "my-folder"); then
      return 1
    fi
    [[ -z "$new_name" ]] && return 1
    new_name="$(_slugify "$new_name")"
    mkdir -p "$dir/$new_name"
    echo "$new_name"
  else
    echo "$choice"
  fi
}

_triage_move() {
  local filepath="$1"
  local category="$2"
  local basename_orig
  basename_orig="$(basename "$filepath")"

  local dest_folder
  if ! dest_folder=$(_triage_pick_dest "$category"); then
    return 1
  fi

  local new_name
  if ! new_name=$(gum input --header "Filename:" --value "$basename_orig"); then
    return 1
  fi
  [[ -z "$new_name" ]] && new_name="$basename_orig"

  local dest_path="$SB_DIR/$category/$dest_folder/$new_name"

  if [[ -e "$dest_path" ]]; then
    if ! gum confirm "Overwrite existing '$new_name' in $category/$dest_folder?"; then
      return 1
    fi
  fi

  mv "$filepath" "$dest_path"

  (cd "$SB_DIR" && nb index reconcile inbox/ 2>/dev/null || true)
  (cd "$SB_DIR" && nb index reconcile "$category/$dest_folder/" 2>/dev/null || true)

  _TRIAGE_MOVED+=("$basename_orig → $category/$dest_folder/$new_name")
}

_triage_delete() {
  local filepath="$1"
  local basename_orig
  basename_orig="$(basename "$filepath")"

  if ! gum confirm "Delete '$basename_orig'?"; then
    return 1
  fi

  rm "$filepath"
  (cd "$SB_DIR" && nb index reconcile inbox/ 2>/dev/null || true)
  _TRIAGE_DELETED+=("$basename_orig")
}

_triage_summary() {
  echo ""
  gum style --bold "Triage Summary"
  echo "  Moved:   ${#_TRIAGE_MOVED[@]}"
  echo "  Deleted: ${#_TRIAGE_DELETED[@]}"
  echo "  Skipped: ${#_TRIAGE_SKIPPED[@]}"
  echo "  Edited:  ${#_TRIAGE_EDITED[@]}"

  if (( ${#_TRIAGE_MOVED[@]} > 0 )); then
    echo ""
    gum style --faint "Moved:"
    for item in "${_TRIAGE_MOVED[@]}"; do
      echo "  $item"
    done
  fi

  if (( ${#_TRIAGE_DELETED[@]} > 0 )); then
    echo ""
    gum style --faint "Deleted:"
    for item in "${_TRIAGE_DELETED[@]}"; do
      echo "  $item"
    done
  fi

  local has_changes
  has_changes="$(cd "$SB_DIR" && git status --porcelain 2>/dev/null)"
  if [[ -n "$has_changes" ]]; then
    echo ""
    if gum confirm "Commit changes to second-brain?"; then
      (cd "$SB_DIR" && git add -A && git commit -m "triage: process inbox items")
    fi
  fi
}

_triage() {
  cd "$SB_DIR" || exit 1

  local -a files=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && files+=("$line")
  done < <(find "$SB_DIR/inbox" -maxdepth 1 -type f ! -name '.*' -print0 \
    | xargs -0 stat -f '%m %N' 2>/dev/null \
    | sort -n \
    | cut -d' ' -f2-)

  if (( ${#files[@]} == 0 )); then
    gum style --foreground 2 "Inbox is empty ✓"
    return 0
  fi

  local total=${#files[@]}
  gum style --bold "Inbox Triage: $total items"
  echo ""

  _TRIAGE_MOVED=()
  _TRIAGE_DELETED=()
  _TRIAGE_SKIPPED=()
  _TRIAGE_EDITED=()

  local i=0
  for f in "${files[@]}"; do
    (( ++i ))
    local fname
    fname="$(basename "$f")"

    echo ""
    gum style --bold --foreground 4 "[$i/$total] $fname"
    _triage_preview "$f"

    while true; do
      local action
      if ! action=$(gum choose --header "Action:" \
        "Move to Project" \
        "Move to Resource" \
        "Move to Area" \
        "Edit" \
        "Delete" \
        "Skip" \
        "Quit"); then
        _triage_summary
        return 0
      fi

      case "$action" in
        "Move to Project")
          if _triage_move "$f" "projects"; then break; fi
          ;;
        "Move to Resource")
          if _triage_move "$f" "resources"; then break; fi
          ;;
        "Move to Area")
          if _triage_move "$f" "areas"; then break; fi
          ;;
        "Edit")
          "${EDITOR:-vim}" "$f"
          _TRIAGE_EDITED+=("$fname")
          echo ""
          gum style --bold --foreground 4 "[$i/$total] $fname"
          _triage_preview "$f"
          ;;
        "Delete")
          if _triage_delete "$f"; then break; fi
          ;;
        "Skip")
          _TRIAGE_SKIPPED+=("$fname")
          break
          ;;
        "Quit")
          _triage_summary
          return 0
          ;;
      esac
    done
  done

  _triage_summary
}

_show_help() {
  cat <<'HELP'
second-brain — Manage Second Brain environment variables

OVERVIEW
  The Second Brain system uses environment variables set in mise.local.toml
  to provide context for task management and note-taking:

  SB_TASK_PROJECT  Current project name. Used by:
                   - tadd/ta: auto-applies project:<name> to Taskwarrior tasks
                   - Starship prompt: displays current project context
                   - /note skill: organizes notes under $SB_DIR/projects/<name>/

  SB_TASK_TAGS     Comma-separated tags. Used by:
                   - tadd/ta: auto-applies +tag to Taskwarrior tasks
                   - Starship prompt: displays current tags

  These variables are stored in mise.local.toml in the current directory.
  mise activates them automatically when you cd into the directory.

USAGE
  second-brain <command> [arguments]

COMMANDS (aliases shown in parens)
  status (s)                  Show current project and tags (key=value format)

  project (p)                 Get current SB_TASK_PROJECT value
  project set (s) <name>      Set SB_TASK_PROJECT in ./mise.local.toml
  project unset (u)           Remove SB_TASK_PROJECT from ./mise.local.toml
  project list (l, ls) [--all] [--flat]
                              List projects in $SB_DIR/projects/ with subfolders
                              Current project marked with *
                              --all    include archived projects
                              --flat   plain names only, no tree or markers (scriptable)
  project archive (a) <name>  Move project to $SB_DIR/archive/
  project unarchive (ua) <name>
                              Restore project from $SB_DIR/archive/

  inbox (i) [title]           Capture a note to the inbox (opens in editor)
  inbox --encrypt [title]     Capture an encrypted note to the inbox

  triage (t)                  Walk through inbox items and file them (weekly review)

  tags                        Get current SB_TASK_TAGS value (comma-separated)
  tag add (a) <tag>           Add a tag (no-op if already present)
  tag rm (r) <tag>            Remove a tag
  tag clear (c)               Remove all tags

  help, --help, -h            Show this help

EXAMPLES
  second-brain project set my-app
  second-brain tag add work
  second-brain tag add refactor
  second-brain status
  # SB_TASK_PROJECT=my-app
  # SB_TASK_TAGS=work,refactor

  second-brain project list
  #   another-project
  # * my-app

  second-brain project archive old-project

AI AGENT USAGE
  Agents can discover the Second Brain context by running:
    second-brain status
  This outputs machine-parseable key=value lines to stdout.
  Empty values indicate the variable is not set for the current directory.
HELP
}

# --- Command dispatch ---

cmd="${1:-status}"

case "$cmd" in
  status|s)
    echo "SB_TASK_PROJECT=$(_current_project)"
    echo "SB_TASK_TAGS=$(_current_tags)"
    ;;
  project|p)
    subcmd="${2:-}"
    case "$subcmd" in
      "")
        _current_project
        ;;
      set|s)
        [[ -z "${3:-}" ]] && { echo "Usage: second-brain project set <name>" >&2; exit 1; }
        _write_key SB_TASK_PROJECT "$3"
        ;;
      unset|u)
        _remove_key SB_TASK_PROJECT
        ;;
      list|l|ls)
        shift 2; _project_list "$@"
        ;;
      archive|a)
        [[ -z "${3:-}" ]] && { echo "Usage: second-brain project archive <name>" >&2; exit 1; }
        _project_archive "$3"
        ;;
      unarchive|ua)
        [[ -z "${3:-}" ]] && { echo "Usage: second-brain project unarchive <name>" >&2; exit 1; }
        _project_unarchive "$3"
        ;;
      *)
        echo "Unknown project subcommand: $subcmd" >&2
        echo "Run 'second-brain help' for usage" >&2
        exit 1
        ;;
    esac
    ;;
  inbox|i)
    shift
    if [[ "${1:-}" == "--encrypt" ]]; then
      shift
      _inbox_encrypt "$@"
    else
      _inbox "$@"
    fi
    ;;
  triage|t)
    _triage
    ;;
  tags)
    _current_tags
    ;;
  tag)
    subcmd="${2:-}"
    case "$subcmd" in
      add|a)
        [[ -z "${3:-}" ]] && { echo "Usage: second-brain tag add <tag>" >&2; exit 1; }
        _tag_add "$3"
        ;;
      rm|r)
        [[ -z "${3:-}" ]] && { echo "Usage: second-brain tag rm <tag>" >&2; exit 1; }
        _tag_rm "$3"
        ;;
      clear|c)
        _remove_key SB_TASK_TAGS
        ;;
      *)
        echo "Unknown tag subcommand: $subcmd" >&2
        echo "Run 'second-brain help' for usage" >&2
        exit 1
        ;;
    esac
    ;;
  help|--help|-h)
    _show_help
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'second-brain help' for usage" >&2
    exit 1
    ;;
esac
